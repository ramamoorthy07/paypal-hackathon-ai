# Copy to .env.local — never commit real secrets.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Sandbox OpenAI key for the chat agent (used from step 5).
OPENAI_API_KEY=

# Webhook ID from the PayPal Developer Dashboard after you subscribe
# https://<your-host>/api/webhooks/paypal. Optional until webhooks are wired.
PAYPAL_WEBHOOK_ID=

# Cap for sandbox invoices. Confirm endpoint will reject amounts above this.
MAX_INVOICE_USD=5000

# SQLite for local development. Postgres later on Render.
DATABASE_URL=file:./data/paypilot.db

# Labeled demo FX only. Confirmation card still requires the user to confirm INR -> USD.
INR_USD_RATE=0.012
