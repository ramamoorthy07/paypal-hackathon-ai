# Copy to .env.local — never commit real secrets.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Azure OpenAI (preferred). OPENAI_API_KEY is the Azure api-key for this resource.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
OPENAI_API_KEY=

# Webhook ID from the PayPal Developer Dashboard after you subscribe
# https://<your-host>/api/webhooks/paypal. Optional locally; invoice pages can poll.
PAYPAL_WEBHOOK_ID=

# Optional. Required in production for GET/POST /api/cron/overdue (Authorization: Bearer).
CRON_SECRET=

# Optional locally. Required in production for /api/chat, confirm, and remind.
# Set a cookie via POST /api/unlock (the /unlock page).
DEMO_ACCESS_CODE=

# Per-IP request cap (chat/confirm/remind/summary/unlock) and daily Azure / PayPal write budgets.
RATE_LIMIT_PER_MINUTE=30
DAILY_LLM_CALL_LIMIT=80
DAILY_PAYPAL_WRITE_LIMIT=20

# Cap for sandbox invoices. Confirm endpoint will reject amounts above this.
MAX_INVOICE_USD=5000

# libSQL. Local file for dev. Turso for production (survives Render restarts).
DATABASE_URL=file:./data/paypilot.db
# Required when DATABASE_URL is a remote libsql:// or https:// Turso URL.
DATABASE_AUTH_TOKEN=

# Live INR→USD from Frankfurter (4h cache). This fallback is used when live FX fails.
# Confirmation card still requires the user to confirm INR → USD.
INR_USD_RATE=0.012

# Optional. Required in production for /api/mcp (Authorization: Bearer).
MCP_BEARER_TOKEN=

# Optional. Only for `npm run spike:client-agent` (never required to run the app).
# PAYPAL_PAYOUT_RECEIVER=
# KERNEL_API_KEY=
